pub const UserRoute = struct {
    pub fn @"publish:event kw.direct/kw.event"(ctx: struct { usize }) struct { key: usize } {
        return .{
            .key = ctx.@"0",
        };
    }
};

pub const InternalRoute = struct {
    pub fn @"publish:logout kw.direct/kw.{user.id}.backchannel_logout"() struct {} {
        return .{};
    }
};

pub const ServerContext = struct {
    user: struct {
        id: []const u8,
    },
};

pub const CronRoute = struct {
    pub fn @"first */15 * * * * *"(inj: *Injector) !void {
        const sch = try inj.require(Scheduler(.amqp));
        std.debug.print("FIRST\n", .{});
        try sch.publish(.{ .event = .{69} }, .{ .inj = inj });
    }

    pub fn @"second 0 */5 * * * *"() void {
        std.debug.print("SECOND\n", .{});
    }
};

const amqp_driver = amqp.Driver
    .new(.amqp)
    .config("driver.amqp")
    .listen(true)
    .jobs(1)
    .routes(
        kwatcher.meta.flatten(&.{
            kwatcher.middleware.latency(
                kwatcher.meta.flatten(&.{
                    amqp.From(UserRoute, ServerContext),
                    //                        kwatcher.protocol.basis,
                }),
            ),
            amqp.From(InternalRoute, ServerContext),
        }),
    )
    .build();

const cron_driver = cron.Driver
    .new(.cron)
    .listen(true)
    .jobs(1)
    .routes(
        cron.From(CronRoute),
    )
    .build();

const drivers = kwatcher.DriverRegistry
    .new()
    .registerHandler(cron_driver)
    .registerHandler(amqp_driver);

const Scheduler = drivers.SchedulerMap();

pub fn juicyMain(allocator: std.mem.Allocator) !void {
    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    const internal = try kwatcher.mem.InternalArena.init(arena.allocator(), kwatcher.metrics.shim);
    try kwatcher.metrics.initialize(allocator, "test", "0.0.0", "test", .{});

    const stdout = std.fs.File.stdout();
    var buf: [256]u8 = undefined;
    var writer = stdout.writer(&buf);
    const interface = &writer.interface;
    defer interface.flush() catch {};
    var client = kwatcher.LoggingClient.init(interface);

    const Shared = struct {
        allocator: std.mem.Allocator,
    };

    const Deps = struct {
        client: kwatcher.Client,
        fmt: kwatcher.InternFmtCache,
        ctx: ServerContext,
        arena: kwatcher.mem.InternalArena,
    };

    var sh: Shared = .{
        .allocator = allocator,
    };

    var ctx: Deps = .{
        .arena = internal,
        .fmt = .init(allocator),
        .ctx = .{
            .user = .{
                .id = "Dumbo",
            },
        },
        .client = client.client(),
    };
    defer ctx.fmt.deinit();
    var dependencies =
        deps.DependencyContainer
            .new(drivers)
            .static(.all, &sh, allocator)
            .static(.amqp, &ctx, allocator);
    defer dependencies.deinit(allocator);

    var server = try kwatcher.server_v2.Server(@TypeOf(dependencies), drivers)
        .init(allocator, dependencies, 4);
    defer server.deinit();

    // const threadgroup = try server.listen();

    if (comptime builtin.os.tag == .linux) {
        // call our shutdown function (below) when
        // SIGINT or SIGTERM are received
        std.posix.sigaction(std.posix.SIG.INT, &.{
            .handler = .{
                .handler = server.stopHandler(&slot),
            },
            .mask = std.posix.sigemptyset(),
            .flags = 0,
        }, null);
        std.posix.sigaction(std.posix.SIG.TERM, &.{
            .handler = .{ .handler = server.stopHandler(&slot) },
            .mask = std.posix.sigemptyset(),
            .flags = 0,
        }, null);
    }

    server.bind();

    const thread = try std.Thread.spawn(
        .{ .allocator = allocator },
        @TypeOf(server).watch,
        .{&server},
    );
    try server.begin();
    thread.join();

    // threadgroup.join();
}

var slot: *anyopaque = undefined;

pub fn main() !void {
    if (comptime builtin.mode == .Debug) {
        var gpa = std.heap.GeneralPurposeAllocator(.{}){};
        const allocator = gpa.allocator();
        try juicyMain(allocator);
    } else {
        const alloc = std.heap.smp_allocator;
        try juicyMain(alloc);
    }
}
