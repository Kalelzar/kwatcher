(module kwatcher:protocol:secret)
(require kwatcher:core)

(defstruct secret-register
  "A secret-store key registration payload."
  (scheme string "The encryption scheme this key is registered for.
v0 defines exactly one value: \"kw.sealed-box.v0\".")
  (public-key string "The client's Ed25519 public key, standard base64 with padding.")
  (kid string "Blake2b-256 of the raw public key, lowercase hex.
Derivable from public_key; included for transparency.")
  (client kwatcher:core:client:v2 "Client information."))

(defstruct secret-get
  "A secret request payload."
  (scheme string "The encryption scheme the response must use.")
  (kid string "The key id the response must be encrypted to.")
  (secret-identifier string "The identifier of the requested secret. Opaque UTF-8;
namespacing is the application's business.")
  (client kwatcher:core:client:v2 "Client information."))

(defstruct secret-response
  "A secret response payload."
  (scheme string "The encryption scheme used to seal the secret.")
  (kid string "The key id the secret is encrypted to.")
  (secret-identifier string "The identifier of the delivered secret.")
  (store kwatcher:core:client:v2 "The responding store's client information.
Self-asserted; informational only in v0.")
  (ephemeral-public-key string "The ephemeral X25519 public key of the sealed box,
standard base64 with padding.")
  (ciphertext string "The sealed secret: ciphertext followed by the 16-byte
Poly1305 tag, standard base64 with padding."))

(defstruct empty
  "An empty payload.")

(defschema register secret-register "secret.register"
  "A secret-store key registration."
  (0 "A secret-store key registration v0.
Broadcast to any listening store; fire-and-forget."
    scheme public-key kid client))

(defschema get secret-get "secret.get"
  "A secret request."
  (0 "A secret request v0.
Carries reply_to = secret.v0.{client_id}; any store holding the secret
may answer on that route over amq.topic. Silence is the only negative
signal."
    scheme kid secret-identifier client))

(defschema response secret-response "secret.response"
  "A secret response."
  (0 "A secret response v0.
The secret is sealed to the public key registered for kid."
    scheme kid secret-identifier store ephemeral-public-key ciphertext))

(defschema reannounce-request empty "secret.reannounce.request"
  "A registration request."
  (0 "A registration request v0.
Empty; clients answer by re-broadcasting their registration on the
canonical route."))

(export register get response reannounce-request
        secret-register secret-get secret-response)
